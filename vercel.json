{
  "installCommand": "",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'sha256-D8GiKF3FrTAuD6N8rSMyL42/W5yIuXLaatb71zNfSwU=' https://cdn.onesignal.com; connect-src 'self' https://onesignal.com https://*.onesignal.com; img-src 'self' data: https://*.onesignal.com; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self'; frame-src https://*.onesignal.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/OneSignalSDKWorker.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/confirmed.html",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "none"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/datenschutz",
      "destination": "/datenschutz.html"
    }
  ],
  "redirects": [
    {
      "source": "/install.html",
      "destination": "https://app.angstdoc.de/",
      "permanent": false
    },
    {
      "source": "/install",
      "destination": "https://app.angstdoc.de/",
      "permanent": false
    }
  ],
  "functions": {
    "api/send-notifications.js": {
      "maxDuration": 30
    }
  }
}
